# ==============================================================================
# NEXTREADER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only service role key (NEVER expose to client)
# Used for administrative operations, webhooks, and background sync
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Razorpay Configuration (Payments & Deposits)
# ------------------------------------------------------------------------------
# In Development, if keys are omitted or NEXT_PUBLIC_DEV_PAYMENT_MODE is true,
# NextReader uses a transparent, clearly-labelled simulated payment adapter.
NEXT_PUBLIC_DEV_PAYMENT_MODE=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# Platform Business Rules
# ------------------------------------------------------------------------------
# Platform fee percentage charged on paid rentals (e.g., 10 for 10%)
PLATFORM_COMMISSION_PERCENTAGE=10

# ------------------------------------------------------------------------------
# Optional Services
# ------------------------------------------------------------------------------
# Optional Google Maps / Mapbox Key for interactive distance visualisations
NEXT_PUBLIC_MAPS_API_KEY=

